@@ -0,0 +1,21 @@
+package guard
+
+// Rev is the pinned QuantumNous/astrlink-guard repository revision.
+const Rev = "7216b6a3b897ef903d4b1ba367ae6fb95b0fa5e4"
+
+// RepoBase is the official Hugging Face resolve prefix for AstrLink Guard.
+const RepoBase = "https://huggingface.co/QuantumNous/astrlink-guard/resolve/"
+
+// PinnedFile describes one release artifact verified by size and SHA-256.
+type PinnedFile struct {
+	Path string
+	Size int64
+	SHA  string
+}
+
+// PinnedFiles lists the pinned int8 AstrLink Guard artifacts.
+var PinnedFiles = []PinnedFile{
+	{"int8/model_int8.onnx", 330781, "0a070d3113615e33ba3b84d6bd486f663a377c04c4b056e7381732179f51832a"},
+	{"int8/model_int8.onnx_data", 37124608, "0ba34216ceead01e0ae2dfd8e46d52b67e7aee80b04f722d9b758613a91c0067"},
+	{"int8/tokenizer.json", 1502881, "0cf3b235ef125658015a6c8026a5fe6f28088bf825101a990ec18a10200feef4"},
+}
